# Copy: cp .env.example .env   (.env nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật ở đây.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật trong .env (local) hoặc biến môi trường trên Railway/Render
AGENT_API_KEY=change-me

# Redis — local: redis://localhost:6379/0 · compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# Số uvicorn worker trong Docker
WEB_CONCURRENCY=2
